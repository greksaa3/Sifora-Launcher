{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sifora Launcher",
  "version": "0.1.0",
  "identifier": "dev.sifora.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Sifora Launcher",
        "width": 1180,
        "height": 760,
        "minWidth": 880,
        "minHeight": 580,
        "center": true,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "shadow": true,
        "dragDropEnabled": true,
        "visible": false,
        "focus": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob: https://cdn.modrinth.com",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "media-src": "'none'",
        "object-src": "'none'",
        "child-src": "'none'",
        "frame-src": "'none'",
        "worker-src": "'self'",
        "manifest-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline' http://localhost:1420 http://localhost:1421",
        "style-src": "'self' 'unsafe-inline' http://localhost:1420",
        "img-src": "'self' asset: http://asset.localhost data: blob: https://cdn.modrinth.com",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1421",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "freezePrototype": true,
      "dangerousDisableAssetCspModification": false,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/backgrounds/*",
          "$APPLOCALDATA/backgrounds/*",
          "$APPDATA/build-icons/*",
          "$APPLOCALDATA/build-icons/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "shortDescription": "Minecraft launcher",
    "longDescription": "Sifora Launcher — a lightweight Minecraft launcher with isolated builds, Fabric/Forge/NeoForge support and built-in Modrinth mod browsing.",
    "copyright": "Copyright (c) 2026 Sifora",
    "publisher": "Sifora",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian", "English"],
        "displayLanguageSelector": true
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": []
  }
}