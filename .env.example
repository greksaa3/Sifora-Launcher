# Sample environment variables for Sifora Launcher.
#
# Copy to `.env` if you need them. `.env` is git-ignored; nothing here is
# required to build or run the launcher.
#
# The application does NOT read these at runtime: the optional AI provider is
# configured inside the app (settings -> AI), and its credentials are stored in
# the OS application-data folder, never in this repository.
#
# Set SIFORA_DEBUG=1 to mirror the in-app log to stderr when developing.

SIFORA_DEBUG=0