# Sample environment variables for Sifora Launcher.
#
# Copy to `.env` if you need them. `.env` is git-ignored; nothing here is
# required to build or run the launcher.
#
# The launcher reads no configuration from the environment at runtime. Every
# setting lives in `settings.json` inside the OS application-data folder and is
# edited in the app, so there are no credentials to put in this file.
#
# Set SIFORA_DEBUG=1 to mirror the in-app log to stderr when developing.

SIFORA_DEBUG=0
